<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Shop segregation. Group rules are OR-ed between the groups of a user:
          * POS User    -> only shops of Sales Teams they lead / are member of / are employee of
          * POS Manager -> everything (implies POS User, the unrestricted rule wins)
        user.pts_crm_team_ids is computed with explicit active filters (independent of active_test)
        and invalidated whenever a membership changes.
    -->

    <!-- pos.config -->
    <record id="rule_pts_pos_config_team_user" model="ir.rule">
        <field name="name">POS Teams Segregation: shops of my Sales Teams</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="domain_force">[('crm_team_id', 'in', user.pts_crm_team_ids.ids)]</field>
    </record>
    <record id="rule_pts_pos_config_manager" model="ir.rule">
        <field name="name">POS Teams Segregation: all shops (POS Administrator)</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- pos.session -->
    <record id="rule_pts_pos_session_team_user" model="ir.rule">
        <field name="name">POS Teams Segregation: sessions of my Sales Teams</field>
        <field name="model_id" ref="point_of_sale.model_pos_session"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="domain_force">[('config_id.crm_team_id', 'in', user.pts_crm_team_ids.ids)]</field>
    </record>
    <record id="rule_pts_pos_session_manager" model="ir.rule">
        <field name="name">POS Teams Segregation: all sessions (POS Administrator)</field>
        <field name="model_id" ref="point_of_sale.model_pos_session"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- pos.order -->
    <record id="rule_pts_pos_order_team_user" model="ir.rule">
        <field name="name">POS Teams Segregation: orders of my Sales Teams</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="domain_force">[('session_id.config_id.crm_team_id', 'in', user.pts_crm_team_ids.ids)]</field>
    </record>
    <record id="rule_pts_pos_order_manager" model="ir.rule">
        <field name="name">POS Teams Segregation: all orders (POS Administrator)</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- pos.payment -->
    <record id="rule_pts_pos_payment_team_user" model="ir.rule">
        <field name="name">POS Teams Segregation: payments of my Sales Teams</field>
        <field name="model_id" ref="point_of_sale.model_pos_payment"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="domain_force">[('session_id.config_id.crm_team_id', 'in', user.pts_crm_team_ids.ids)]</field>
    </record>
    <record id="rule_pts_pos_payment_manager" model="ir.rule">
        <field name="name">POS Teams Segregation: all payments (POS Administrator)</field>
        <field name="model_id" ref="point_of_sale.model_pos_payment"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- report.pos.order (Orders Analysis) -->
    <record id="rule_pts_report_pos_order_team_user" model="ir.rule">
        <field name="name">POS Teams Segregation: order analysis of my Sales Teams</field>
        <field name="model_id" ref="point_of_sale.model_report_pos_order"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="domain_force">[('config_id.crm_team_id', 'in', user.pts_crm_team_ids.ids)]</field>
    </record>
    <record id="rule_pts_report_pos_order_manager" model="ir.rule">
        <field name="name">POS Teams Segregation: all order analysis (POS Administrator)</field>
        <field name="model_id" ref="point_of_sale.model_report_pos_order"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
